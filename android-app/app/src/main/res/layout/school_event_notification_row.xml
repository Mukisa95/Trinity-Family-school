<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/event_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp" android:orientation="vertical" android:paddingHorizontal="2dp">
    <TextView android:id="@+id/event_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:textSize="10sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/event_classes" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:includeFontPadding="false" android:visibility="gone" />
    <TextView android:id="@+id/event_title" android:layout_width="match_parent" android:layout_height="12dp" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
