{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/lib/offline/android-contracts.ts",
    "src/lib/offline/android-session-policy.ts",
    "src/lib/offline/android-cache-export.ts",
    "src/components/providers/android-offline-provider.tsx",
    "src/android-offline/app.tsx",
    "src/app/api/offline/session/route.ts",
    "src/app/timetable/page.tsx",
    "src/components/timetable/TimetableViewPanel.tsx"
  ],
  "exclude": [
    "node_modules",
    "output"
  ]
}
