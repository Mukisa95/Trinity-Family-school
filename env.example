# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin / Google Cloud Monitoring (required for the in-app Usage page)
# Create a service account for this project and grant it Cloud Datastore Viewer
# plus Monitoring Viewer. Keep these values server-side only.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=your_project_id.appspot.com

# Optional exact expenditure for the manual Firebase Usage dashboard.
# Point this at the Standard Cloud Billing export table. The API hard-caps each
# query at 100 MiB unless you deliberately choose a different positive limit.
FIREBASE_BILLING_BIGQUERY_PROJECT_ID=your_project_id
FIREBASE_BILLING_BIGQUERY_TABLE=your_project_id.billing_export.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
FIREBASE_BILLING_BIGQUERY_MAX_BYTES=104857600

# Push Notification VAPID Keys (Generated with npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BMOU7Zc7H4Kx4pgm8KBjrIxPBZcYxFYoz5kxVOmHHI4Up5mNxnXGpbc91fBEZcndzU0E9Zk7AFUAelNuD6RXnWY
VAPID_PRIVATE_KEY=SEiNkLitzwAM2fJQowy_UDGy2yr-EPCRe-3lyWvR9LE

# Email Configuration (for VAPID)
VAPID_EMAIL=admin@trinity-family-schools.com

# SchoolPay Integration
# Server-side credentials only. Do not expose these in client-side code.
SCHOOLPAY_SCHOOL_CODE=your_schoolpay_school_code
SCHOOLPAY_API_PASSWORD=your_schoolpay_api_password
SCHOOLPAY_SYNC_BASE_URL=https://schoolpay.co.ug/paymentapi

# Development
NODE_ENV=development
