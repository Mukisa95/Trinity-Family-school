{
  "crons": [
    {
      "path": "/api/maintenance/snapshots",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/schoolpay-sync",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/finalize-staff-clocking",
      "schedule": "15 22 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "codex/application-performance": true
    }
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.cjs"
}
