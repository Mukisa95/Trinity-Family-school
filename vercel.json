{
  "crons": [
    {
      "path": "/api/maintenance/snapshots",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/schoolpay-sync",
      "schedule": "15 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "codex/application-performance": true
    }
  },
  "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_FORCE_BUILD === '1' || process.env.VERCEL_ENV !== 'preview' || process.env.VERCEL_GIT_COMMIT_REF === 'codex/application-performance' ? 1 : 0)\""
}
