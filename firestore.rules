rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Application users sign in through the server-verified custom-token flow.
    // These claims are carried in the Firebase ID token, so normal reads do not
    // require an extra Firestore lookup and the cache/live-sync path stays fast.
    function isActiveApplicationUser() {
      return request.auth != null
        && request.auth.token.appUser == true
        && request.auth.token.isActive == true;
    }

    // These role and family checks use signed Firebase ID-token claims only.
    // They do not perform rule-level document lookups or inspect browser cache.
    function isStaffOrAdmin() {
      return isActiveApplicationUser()
        && (request.auth.token.role == 'Admin' || (request.auth.token.role == 'Staff' && get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.isActive == true));
    }
    function staffCircumference() {
      return get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data
        .get('circumference', {'classIds': null, 'sections': null, 'genders': null});
    }
    function isUnrestrictedStaffOrAdmin() {
      return isStaffOrAdmin() && (request.auth.token.role == 'Admin'
        || (staffCircumference().get('classIds', null) == null
          && staffCircumference().get('sections', null) == null
          && staffCircumference().get('genders', null) == null));
    }
    function scopedClass(classId) {
      return isStaffOrAdmin() && (request.auth.token.role == 'Admin'
        || staffCircumference().get('classIds', null) == null
        || classId in staffCircumference().classIds);
    }
    function scopedPupil(data) {
      return scopedClass(data.get('classId', ''))
        && (request.auth.token.role == 'Admin'
          || ((staffCircumference().get('sections', null) == null || data.get('section', '') in staffCircumference().sections)
            && (staffCircumference().get('genders', null) == null || data.get('gender', '') in staffCircumference().genders)));
    }
    function scopedPupilId(pupilId) {
      return pupilId is string && pupilId != ''
        && scopedPupil(get(/databases/$(database)/documents/pupils/$(pupilId)).data);
    }
    function scopedPupilRecord(data) {
      return isUnrestrictedStaffOrAdmin() || scopedPupilId(data.get('pupilId', ''));
    }
    function classWideScope(classId) {
      return scopedClass(classId) && (request.auth.token.role == 'Admin'
        || (staffCircumference().get('sections', null) == null && staffCircumference().get('genders', null) == null));
    }

    function isTrustedServerApp() {
      return isActiveApplicationUser()
        && request.auth.token.serverApp == true
        && request.auth.token.role == 'Server';
    }

    function isParentForFamily(familyId) {
      return isActiveApplicationUser()
        && request.auth.token.role == 'Parent'
        && request.auth.token.familyId == familyId;
    }

    function isParentForPupilRecord(pupilId) {
      return isActiveApplicationUser()
        && request.auth.token.role == 'Parent'
        && resource.data.parentAccountActive == true
        && resource.data.parentAccountId == request.auth.uid;
    }

    // These are the only documents intentionally displayed before sign-in on
    // the school's public login/landing page. Keep this whitelist narrow: no
    // other collection inherits anonymous access from these rules.
    match /settings/{settingsDoc} {
      // The landing page needs the public profile and its tiny change token
      // before sign-in. Operational revision documents remain authenticated.
      allow read: if settingsDoc == 'school-settings'
        || settingsDoc == 'school-settings-meta'
        || isActiveApplicationUser();
      allow write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isUnrestrictedStaffOrAdmin();
    }

    // Password verifiers are server-only. Admin SDK operations bypass Firestore
    // Rules and are authorized separately by the Vercel service account.
    match /authCredentials/{credentialPath=**} {
      allow read, write: if false;
    }

    // Profiles remain readable to signed-in application users because recipient
    // pickers, notifications, and permission refreshes use this collection.
    // All mutations go through protected server API routes.
    match /system_users/{userPath=**} {
      allow read: if isActiveApplicationUser();
      allow write: if false;
    }

    // Parent reads are constrained by the account marker on each pupil. This
    // changes immediately when membership changes and covers both families and
    // standalone pupils without a rule-level document lookup.
    match /pupils/{pupilId} {
      allow read: if isTrustedServerApp()
        || scopedPupil(resource.data)
        || isParentForPupilRecord(pupilId);
      // parentAccountId is an authorization boundary, so parent browsers can
      // never assign or alter it directly.
      allow create: if isTrustedServerApp() || scopedPupil(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupil(resource.data) && scopedPupil(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupil(resource.data);
    }

    // Dev Contral reads are administrator-only. Operational telemetry still
    // accepts create-only summaries from active app users.
    match /historicalPupilSeeds/{seedId} {
      allow read, write: if isActiveApplicationUser() && request.auth.token.role == 'Admin';
    }

    match /operationalAuditLogs/{auditId} {
      allow read: if isActiveApplicationUser() && request.auth.token.role == 'Admin';
      allow create: if isActiveApplicationUser();
      allow update, delete: if false;
    }

    // Banking records predate the family ownership field used by the parent
    // dashboard. Parents therefore receive their own child's compact banking
    // projection from the server, after it has checked the pupil's family.
    // Do not let a parent query these raw collections while that ownership is
    // not rule-checkable on every legacy record.
    match /bankAccounts/{accountId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }

    match /bankLoans/{loanId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }

    match /bankTransactions/{transactionId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }

    // A parent receives only its account's compact change counters. The
    // counters contain no banking values and let an offline dashboard refresh
    // one saved child only after a relevant school-side change.
    match /parentDashboardRevisions/{accountId} {
      allow read: if isTrustedServerApp()
        || isUnrestrictedStaffOrAdmin()
        || (isActiveApplicationUser()
          && request.auth.token.role == 'Parent'
          && request.auth.uid == accountId);
      allow write: if false;
    }

    // Parent attendance is supplied by the verified server projection. This
    // prevents a browser caller from reading another child's history or
    // changing a staff attendance record directly.
    match /attendanceRecords/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }

    // A released exam source document holds every learner in a class. The
    // parent dashboard receives a server-filtered, one-child projection only.
    match /examResults/{resultId} {
      allow read, delete: if isTrustedServerApp() || classWideScope(resource.data.get('classId', ''));
      allow create: if isTrustedServerApp() || classWideScope(request.resource.data.get('classId', ''));
      allow update: if isTrustedServerApp() || (classWideScope(resource.data.get('classId', '')) && classWideScope(request.resource.data.get('classId', '')));
    }

    // Release lists contain the identifiers of other children in the class.
    // They are used by the server projection and are never a parent query.
    match /resultReleases/{releaseId} {
      allow read, delete: if isTrustedServerApp() || classWideScope(resource.data.get('classId', ''));
      allow create: if isTrustedServerApp() || classWideScope(request.resource.data.get('classId', ''));
      allow update: if isTrustedServerApp() || (classWideScope(resource.data.get('classId', '')) && classWideScope(request.resource.data.get('classId', '')));
    }

    // Ordered pupil cache deltas contain only revision, pupil id, and operation.
    // Staff/admin mutations publish them atomically with the source document;
    // parent devices continue using their family-scoped pupils query.
    match /pupilCacheChanges/{changeId} {
      allow read, update, delete: if isTrustedServerApp() || isUnrestrictedStaffOrAdmin();
      allow create: if isTrustedServerApp() || isUnrestrictedStaffOrAdmin()
        || (request.resource.data.get('operation', '') == 'delete' && scopedPupilId(request.resource.data.get('pupilId', '')))
        || scopedPupil(getAfter(/databases/$(database)/documents/pupils/$(request.resource.data.pupilId)).data);
    }

    // Browser endpoints are owned by the verified Firebase identity. Clients
    // may inspect only their own record; creation, reassignment, and logout
    // cleanup go through the trusted subscription API.
    match /pushSubscriptions/{subscriptionId} {
      allow read: if isTrustedServerApp()
        || isUnrestrictedStaffOrAdmin()
        || (isActiveApplicationUser() && resource.data.userId == request.auth.uid);
      allow write: if isTrustedServerApp();
    }

    // This derived document contains school-wide pupil attendance details.
    // Parents must continue through their family-scoped attendance flow.
    match /attendanceDailySummaries/{summaryId} {
      allow read, write: if isUnrestrictedStaffOrAdmin();
    }

    // Automation configuration and execution logs are server-owned. The
    // settings screen goes through a permission-checked API route so a signed
    // browser cannot change school-wide reminder behaviour directly.
    match /notificationAutomationSettings/{settingsId} {
      allow read, write: if false;
    }

    // Item requests are intentionally server-owned. A request-only account
    // must never be able to list another staff member's request, change its
    // status, or write an Inventory movement by bypassing the page UI.
    match /itemRequests/{requestId} {
      allow read, write: if false;
    }

    match /itemRequestEvents/{eventId} {
      allow read, write: if false;
    }

    match /itemRequestOperations/{operationId} {
      allow read, write: if false;
    }

    match /itemRequestDecisionOperations/{operationId} {
      allow read, write: if false;
    }

    // Restock instructions drive Procurement work but are never completed
    // purchase records. They are server-owned to prevent fake or duplicate
    // procurement work from a browser retry.
    match /procurementRestockRequests/{restockRequestId} {
      allow read, write: if false;
    }

    match /itemRequestRestockOperations/{operationId} {
      allow read, write: if false;
    }

    match /attendanceReminderRuns/{runId} {
      allow read, write: if false;
    }

    match /scheduledNotifications/{scheduleId} {
      allow read, write: if false;
    }

    // All schedule mutations go through permission-checked server routes so
    // the source document and its due pointer cannot drift apart.
    match /scheduledSMS/{scheduleId} {
      allow read: if isUnrestrictedStaffOrAdmin();
      allow write: if false;
    }

    match /scheduledDispatchQueue/{dispatchId} {
      allow read, write: if false;
    }

    // Fee promises and parent contact details are served by authenticated Fees APIs.
    match /feeReminderTargets/{pupilId} {
      allow read, write: if false;
    }

    match /feeReminders/{reminderId} {
      allow read, write: if false;
    }

    // Canonical SchoolPay callbacks are written only by trusted server routes.
    match /schoolPayInboundTransactions/{transactionId} {
      allow read: if isUnrestrictedStaffOrAdmin();
      allow write: if false;
    }

    match /schoolPayReconciliationState/{dateId} {
      allow read, write: if false;
    }

    match /schoolPaySyncLogs/{logId} {
      allow read, write: if isUnrestrictedStaffOrAdmin();
    }

    match /schoolPayPaymentMappings/{receiptId} {
      allow read, write: if isUnrestrictedStaffOrAdmin();
    }

    // Salary data is especially sensitive. Payroll reads and all mutations use
    // authenticated, permission-checked server routes; browser SDK access is
    // intentionally denied even to administrators.
    match /staffSalaryProfiles/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryComponents/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryPayments/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryOccurrences/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryAdjustments/{documentPath=**} {
      allow read, write: if false;
    }

    // WhatsApp webhook records and inbox messages are written and read through
    // permission-checked server routes. Do not expose phone conversations to
    // the browser Firebase SDK or the broad transitional rule below.
    match /whatsappConversations/{conversationId} {
      allow read, write: if false;
    }

    match /whatsappMessages/{messageId} {
      allow read, write: if false;
    }


    // Definitions may be shared; class selection and exam creation stay inside
    // the user's class Circumference. Mixed result documents are projected by
    // the authenticated API for section/gender scopes.
    match /classes/{classId} {
      allow read: if isTrustedServerApp() || scopedClass(classId) || (isActiveApplicationUser() && request.auth.token.role == 'Parent');
      allow create, update, delete: if isTrustedServerApp() || scopedClass(classId);
    }
    match /classes/{classId}/{documentPath=**} {
      allow read, write: if isTrustedServerApp() || scopedClass(classId);
    }
    match /exams/{examId} {
      allow read, delete: if isTrustedServerApp() || scopedClass(resource.data.get('classId', '')) || (isActiveApplicationUser() && request.auth.token.role == 'Parent');
      allow create: if isTrustedServerApp() || scopedClass(request.resource.data.get('classId', ''));
      allow update: if isTrustedServerApp() || (scopedClass(resource.data.get('classId', '')) && scopedClass(request.resource.data.get('classId', '')));
    }
    match /payments/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }
    match /feesHolidays/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }
    match /feeAdjustments/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }
    match /pupilTermSnapshots/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }
    match /pupilSnapshots/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }
    match /uniformTracking/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }
    match /requirement-tracking/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }
    match /pupilHistory/{recordId} {
      allow read: if isTrustedServerApp() || scopedPupilRecord(resource.data);
      allow create: if isTrustedServerApp() || scopedPupilRecord(request.resource.data);
      allow update: if isTrustedServerApp() || (scopedPupilRecord(resource.data) && scopedPupilRecord(request.resource.data));
      allow delete: if isTrustedServerApp() || scopedPupilRecord(resource.data);
    }

    match /dormitories/{dormitoryId} {
      allow read, write: if isTrustedServerApp() || isUnrestrictedStaffOrAdmin();
    }
    match /examLocks/{examId} {
      allow read, write: if isTrustedServerApp() || scopedClass(get(/databases/$(database)/documents/exams/$(examId)).data.get('classId', ''));
    }
    match /digital_signatures/{signatureId} {
      allow read: if isUnrestrictedStaffOrAdmin() || (isStaffOrAdmin() && (!exists(/databases/$(database)/documents/digital_signatures/$(signatureId)) || resource.data.userId == request.auth.uid));
      allow create: if isTrustedServerApp() || isUnrestrictedStaffOrAdmin() || (isStaffOrAdmin() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isTrustedServerApp() || isUnrestrictedStaffOrAdmin();
    }
    match /audit_trail/{auditId} {
      allow read: if isUnrestrictedStaffOrAdmin() || (isStaffOrAdmin() && (!exists(/databases/$(database)/documents/audit_trail/$(auditId)) || resource.data.signature.userId == request.auth.uid));
      allow create: if isTrustedServerApp() || isUnrestrictedStaffOrAdmin() || (isStaffOrAdmin() && request.resource.data.signature.userId == request.auth.uid);
      allow update, delete: if isTrustedServerApp() || isUnrestrictedStaffOrAdmin();
    }

    match /academicYears/{yearId} {
      allow read: if isActiveApplicationUser();
      allow write: if isTrustedServerApp() || isStaffOrAdmin();
    }
    match /academicYears/{yearId}/terms/{termId} {
      allow read: if isActiveApplicationUser();
      allow write: if isTrustedServerApp() || isStaffOrAdmin();
    }
    function scopedTimetable(data) {
      return isStaffOrAdmin() && (request.auth.token.role == 'Admin' || staffCircumference().get('classIds', null) == null || data.get('classIds', []).hasAny(staffCircumference().classIds));
    }
    function managesTimetable(data) {
      return isStaffOrAdmin() && (request.auth.token.role == 'Admin' || staffCircumference().get('classIds', null) == null || data.get('classIds', []).hasOnly(staffCircumference().classIds));
    }
    match /academicYears/{yearId}/terms/{termId}/timetables/{tableId} {
      allow read: if isTrustedServerApp() || scopedTimetable(resource.data);
      allow create: if isTrustedServerApp() || managesTimetable(request.resource.data);
      allow update: if isTrustedServerApp() || (managesTimetable(resource.data) && managesTimetable(request.resource.data));
      allow delete: if isTrustedServerApp() || managesTimetable(resource.data);
    }
    match /academicYears/{yearId}/terms/{termId}/timetables/{tableId}/periods/{periodId} {
      allow read: if isTrustedServerApp() || scopedTimetable(get(/databases/$(database)/documents/academicYears/$(yearId)/terms/$(termId)/timetables/$(tableId)).data);
      allow write: if isTrustedServerApp() || managesTimetable(get(/databases/$(database)/documents/academicYears/$(yearId)/terms/$(termId)/timetables/$(tableId)).data);
    }
    match /academicYears/{yearId}/terms/{termId}/timetables/{tableId}/entries/{entryId} {
      allow read, delete: if isTrustedServerApp() || scopedClass(resource.data.get('classId', ''));
      allow create: if isTrustedServerApp() || scopedClass(request.resource.data.get('classId', ''));
      allow update: if isTrustedServerApp() || (scopedClass(resource.data.get('classId', '')) && scopedClass(request.resource.data.get('classId', '')));
    }

    // Transitional production boundary: preserve every existing authenticated
    // application flow while denying anonymous users and arbitrary Firebase
    // anonymous accounts. Collection-level role restrictions are introduced
    // only after this canary proves all current workflows.
    // Clocking configuration, schedules, events and daily records are
    // server-owned. A browser must never create a clock event, alter policy,
    // or query another staff member's history through the Firebase SDK.
    match /staffClockingSettings/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingSchedules/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingQrSessions/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingEvents/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingDailyRecords/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingExemptions/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingCorrections/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingNotifications/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffClockingOperations/{documentPath=**} {
      allow read, write: if false;
    }

    match /{collection}/{documentPath=**} {
      allow read, write: if collection != 'authCredentials'
        && collection != 'system_users'
        && collection != 'pupils'
        && (collection != 'academicYears' || request.auth.token.role != 'Staff' || isUnrestrictedStaffOrAdmin())
        && collection != 'classes'
        && collection != 'dormitories'
        && collection != 'examLocks'
        && collection != 'digital_signatures'
        && collection != 'audit_trail'
        && collection != 'exams'
        && collection != 'payments'
        && collection != 'feesHolidays'
        && collection != 'feeAdjustments'
        && collection != 'pupilTermSnapshots'
        && collection != 'pupilSnapshots'
        && collection != 'uniformTracking'
        && collection != 'requirementTracking'
        && collection != 'requirement-tracking'
        && collection != 'pupilHistory'
        && collection != 'historicalPupilSeeds'
        && collection != 'operationalAuditLogs'
        && collection != 'bankAccounts'
        && collection != 'bankLoans'
        && collection != 'bankTransactions'
        && collection != 'parentDashboardRevisions'
        && collection != 'attendanceRecords'
        && collection != 'examResults'
        && collection != 'resultReleases'
        && collection != 'pupilCacheChanges'
        && collection != 'pushSubscriptions'
        && collection != 'settings'
        && collection != 'photos'
        && collection != 'attendanceDailySummaries'
        && collection != 'notificationAutomationSettings'
        && collection != 'itemRequests'
        && collection != 'itemRequestEvents'
        && collection != 'itemRequestOperations'
        && collection != 'itemRequestDecisionOperations'
        && collection != 'procurementRestockRequests'
        && collection != 'itemRequestRestockOperations'
        && collection != 'attendanceReminderRuns'
        && collection != 'scheduledNotifications'
        && collection != 'scheduledSMS'
        && collection != 'scheduledDispatchQueue'
        && collection != 'feeReminders'
        && collection != 'feeReminderTargets'
        && collection != 'schoolPayInboundTransactions'
        && collection != 'schoolPayReconciliationState'
        && collection != 'schoolPaySyncLogs'
        && collection != 'schoolPayPaymentMappings'
        && collection != 'staffClockingSettings'
        && collection != 'staffClockingSchedules'
        && collection != 'staffClockingQrSessions'
        && collection != 'staffClockingEvents'
        && collection != 'staffClockingDailyRecords'
        && collection != 'staffClockingExemptions'
        && collection != 'staffClockingCorrections'
        && collection != 'staffClockingNotifications'
        && collection != 'staffClockingOperations'
        && collection != 'staffSalaryProfiles'
        && collection != 'staffSalaryComponents'
        && collection != 'staffSalaryPayments'
        && collection != 'staffSalaryOccurrences'
        && collection != 'staffSalaryAdjustments'
        && isActiveApplicationUser()
        && (request.auth.token.role != 'Staff' || isUnrestrictedStaffOrAdmin()
          || collection in ['subjects', 'staff', 'academicYears', 'academic_years', 'feeStructures', 'requirements', 'requirementItems', 'uniforms', 'uniformInventory', 'dynamicDiscounts', 'excludedDays', 'pleSubjects', 'houses', 'access_levels', 'accessLevels', 'examTypes', 'timetablePeriods', 'timetableProfiles', 'schoolSettings', 'gradingScales', 'roleDefinitions', 'departmentDefinitions']
          || (request.method == 'create' && collection in ['historyLogs', 'pupilCacheChanges']));
    }
  }
}
