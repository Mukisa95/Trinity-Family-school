rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Application users sign in through the server-verified custom-token flow.
    // These claims are carried in the Firebase ID token, so normal reads do not
    // require an extra Firestore lookup and the cache/live-sync path stays fast.
    function isActiveApplicationUser() {
      return request.auth != null
        && request.auth.token.appUser == true
        && request.auth.token.isActive == true;
    }

    // These role and family checks use signed Firebase ID-token claims only.
    // They do not perform rule-level document lookups or inspect browser cache.
    function isStaffOrAdmin() {
      return isActiveApplicationUser()
        && (request.auth.token.role == 'Admin' || request.auth.token.role == 'Staff');
    }

    function isTrustedServerApp() {
      return isActiveApplicationUser()
        && request.auth.token.serverApp == true
        && request.auth.token.role == 'Server';
    }

    function isParentForFamily(familyId) {
      return isActiveApplicationUser()
        && request.auth.token.role == 'Parent'
        && request.auth.token.familyId == familyId;
    }

    function isParentForPupilRecord(pupilId) {
      return isActiveApplicationUser()
        && request.auth.token.role == 'Parent'
        && resource.data.parentAccountActive == true
        && resource.data.parentAccountId == request.auth.uid;
    }

    // These are the only documents intentionally displayed before sign-in on
    // the school's public login/landing page. Keep this whitelist narrow: no
    // other collection inherits anonymous access from these rules.
    match /settings/{settingsDoc} {
      // The landing page needs the public profile and its tiny change token
      // before sign-in. Operational revision documents remain authenticated.
      allow read: if settingsDoc == 'school-settings'
        || settingsDoc == 'school-settings-meta'
        || isActiveApplicationUser();
      allow write: if isStaffOrAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isStaffOrAdmin();
    }

    // Password verifiers are server-only. Admin SDK operations bypass Firestore
    // Rules and are authorized separately by the Vercel service account.
    match /authCredentials/{credentialPath=**} {
      allow read, write: if false;
    }

    // Profiles remain readable to signed-in application users because recipient
    // pickers, notifications, and permission refreshes use this collection.
    // All mutations go through protected server API routes.
    match /system_users/{userPath=**} {
      allow read: if isActiveApplicationUser();
      allow write: if false;
    }

    // Parent reads are constrained by the account marker on each pupil. This
    // changes immediately when membership changes and covers both families and
    // standalone pupils without a rule-level document lookup.
    match /pupils/{pupilId} {
      allow read: if isTrustedServerApp()
        || isStaffOrAdmin()
        || isParentForPupilRecord(pupilId);
      // parentAccountId is an authorization boundary, so parent browsers can
      // never assign or alter it directly.
      allow write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    // Dev Contral reads are administrator-only. Operational telemetry still
    // accepts create-only summaries from active app users.
    match /historicalPupilSeeds/{seedId} {
      allow read, write: if isActiveApplicationUser() && request.auth.token.role == 'Admin';
    }

    match /operationalAuditLogs/{auditId} {
      allow read: if isActiveApplicationUser() && request.auth.token.role == 'Admin';
      allow create: if isActiveApplicationUser();
      allow update, delete: if false;
    }

    // Banking records predate the family ownership field used by the parent
    // dashboard. Parents therefore receive their own child's compact banking
    // projection from the server, after it has checked the pupil's family.
    // Do not let a parent query these raw collections while that ownership is
    // not rule-checkable on every legacy record.
    match /bankAccounts/{accountId} {
      allow read, write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    match /bankLoans/{loanId} {
      allow read, write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    match /bankTransactions/{transactionId} {
      allow read, write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    // A parent receives only its account's compact change counters. The
    // counters contain no banking values and let an offline dashboard refresh
    // one saved child only after a relevant school-side change.
    match /parentDashboardRevisions/{accountId} {
      allow read: if isTrustedServerApp()
        || isStaffOrAdmin()
        || (isActiveApplicationUser()
          && request.auth.token.role == 'Parent'
          && request.auth.uid == accountId);
      allow write: if false;
    }

    // Parent attendance is supplied by the verified server projection. This
    // prevents a browser caller from reading another child's history or
    // changing a staff attendance record directly.
    match /attendanceRecords/{recordId} {
      allow read, write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    // A released exam source document holds every learner in a class. The
    // parent dashboard receives a server-filtered, one-child projection only.
    match /examResults/{resultId} {
      allow read, write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    // Release lists contain the identifiers of other children in the class.
    // They are used by the server projection and are never a parent query.
    match /resultReleases/{releaseId} {
      allow read, write: if isTrustedServerApp() || isStaffOrAdmin();
    }

    // Ordered pupil cache deltas contain only revision, pupil id, and operation.
    // Staff/admin mutations publish them atomically with the source document;
    // parent devices continue using their family-scoped pupils query.
    match /pupilCacheChanges/{changeId} {
      allow read, write: if isStaffOrAdmin();
    }

    // Browser endpoints are owned by the verified Firebase identity. Clients
    // may inspect only their own record; creation, reassignment, and logout
    // cleanup go through the trusted subscription API.
    match /pushSubscriptions/{subscriptionId} {
      allow read: if isTrustedServerApp()
        || isStaffOrAdmin()
        || (isActiveApplicationUser() && resource.data.userId == request.auth.uid);
      allow write: if isTrustedServerApp();
    }

    // This derived document contains school-wide pupil attendance details.
    // Parents must continue through their family-scoped attendance flow.
    match /attendanceDailySummaries/{summaryId} {
      allow read, write: if isStaffOrAdmin();
    }

    // Automation configuration and execution logs are server-owned. The
    // settings screen goes through a permission-checked API route so a signed
    // browser cannot change school-wide reminder behaviour directly.
    match /notificationAutomationSettings/{settingsId} {
      allow read, write: if false;
    }

    // Item requests are intentionally server-owned. A request-only account
    // must never be able to list another staff member's request, change its
    // status, or write an Inventory movement by bypassing the page UI.
    match /itemRequests/{requestId} {
      allow read, write: if false;
    }

    match /itemRequestEvents/{eventId} {
      allow read, write: if false;
    }

    match /itemRequestOperations/{operationId} {
      allow read, write: if false;
    }

    match /itemRequestDecisionOperations/{operationId} {
      allow read, write: if false;
    }

    // Restock instructions drive Procurement work but are never completed
    // purchase records. They are server-owned to prevent fake or duplicate
    // procurement work from a browser retry.
    match /procurementRestockRequests/{restockRequestId} {
      allow read, write: if false;
    }

    match /itemRequestRestockOperations/{operationId} {
      allow read, write: if false;
    }

    match /attendanceReminderRuns/{runId} {
      allow read, write: if false;
    }

    match /scheduledNotifications/{scheduleId} {
      allow read, write: if false;

      // The trusted payment API commits a durable push job in the same
      // transaction as the payment. Browser sessions cannot forge jobs.
      match /outbox/{eventId} {
        allow create: if isTrustedServerApp();
        allow read, update, delete: if false;
      }
    }

    // All schedule mutations go through permission-checked server routes so
    // the source document and its due pointer cannot drift apart.
    match /scheduledSMS/{scheduleId} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
    }

    match /scheduledDispatchQueue/{dispatchId} {
      allow read, write: if false;
    }

    // Canonical SchoolPay callbacks are written only by trusted server routes.
    match /schoolPayInboundTransactions/{transactionId} {
      allow read: if isStaffOrAdmin();
      allow write: if false;
    }

    match /schoolPayReconciliationState/{dateId} {
      allow read, write: if false;
    }

    match /schoolPaySyncLogs/{logId} {
      allow read, write: if isStaffOrAdmin();
    }

    match /schoolPayPaymentMappings/{receiptId} {
      allow read, write: if isStaffOrAdmin();
    }

    // Salary data is especially sensitive. Payroll reads and all mutations use
    // authenticated, permission-checked server routes; browser SDK access is
    // intentionally denied even to administrators.
    match /staffSalaryProfiles/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryComponents/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryPayments/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryOccurrences/{documentPath=**} {
      allow read, write: if false;
    }

    match /staffSalaryAdjustments/{documentPath=**} {
      allow read, write: if false;
    }

    // WhatsApp webhook records and inbox messages are written and read through
    // permission-checked server routes. Do not expose phone conversations to
    // the browser Firebase SDK or the broad transitional rule below.
    match /whatsappConversations/{conversationId} {
      allow read, write: if false;
    }

    match /whatsappMessages/{messageId} {
      allow read, write: if false;
    }

    // Transitional production boundary: preserve every existing authenticated
    // application flow while denying anonymous users and arbitrary Firebase
    // anonymous accounts. Collection-level role restrictions are introduced
    // only after this canary proves all current workflows.
    match /{collection}/{documentPath=**} {
      allow read, write: if collection != 'authCredentials'
        && collection != 'system_users'
        && collection != 'pupils'
        && collection != 'historicalPupilSeeds'
        && collection != 'operationalAuditLogs'
        && collection != 'bankAccounts'
        && collection != 'bankLoans'
        && collection != 'bankTransactions'
        && collection != 'parentDashboardRevisions'
        && collection != 'attendanceRecords'
        && collection != 'examResults'
        && collection != 'resultReleases'
        && collection != 'pupilCacheChanges'
        && collection != 'pushSubscriptions'
        && collection != 'settings'
        && collection != 'photos'
        && collection != 'attendanceDailySummaries'
        && collection != 'notificationAutomationSettings'
        && collection != 'itemRequests'
        && collection != 'itemRequestEvents'
        && collection != 'itemRequestOperations'
        && collection != 'itemRequestDecisionOperations'
        && collection != 'procurementRestockRequests'
        && collection != 'itemRequestRestockOperations'
        && collection != 'attendanceReminderRuns'
        && collection != 'scheduledNotifications'
        && collection != 'scheduledSMS'
        && collection != 'scheduledDispatchQueue'
        && collection != 'schoolPayInboundTransactions'
        && collection != 'schoolPayReconciliationState'
        && collection != 'schoolPaySyncLogs'
        && collection != 'schoolPayPaymentMappings'
        && collection != 'staffSalaryProfiles'
        && collection != 'staffSalaryComponents'
        && collection != 'staffSalaryPayments'
        && collection != 'staffSalaryOccurrences'
        && collection != 'staffSalaryAdjustments'
        && isActiveApplicationUser();
    }
  }
}
